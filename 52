total = 0
num = int(input("Digite o numero: "))

for i in range(1, num + 1):
    if num % i == 0:
        print("\033[32m", end="")
        total += 1
    else:
        print("\033[31m", end="")

    print(f"{i}", end=" ")

print(f"\n\033[m O {num} foi divisivel em {total}")
if total == 2:
    print("Seu numero é primo")
else:
    print("Seu número não é primo")

