numeros = []
for i in range(3):
   numero = int(input(f'Digite {i+1} numero: '))
   numeros.append(numero)

a,b,c = numeros # criar um despacotamendo 

if a < b + c and b < a + c and c < a + b:
   print('Podem formar um triangulo')
   if a == b == c:
      print('Equilatero')
   elif a !=b and a!= c and b != c:
      print('Escaleno')
   else:
      print('Isoceles')
else:
   print('Os segumentos precisam criar um triangulo!')
       