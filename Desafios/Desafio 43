peso = float(input('Digite seu Peso (kg): '))
altura = float(input('Digite sua altura (m): '))

imc = peso / (altura *altura)

if imc < 18.5:
    print('\033[1;31mAbaixo do peso\033[m')
elif 18.5 <= imc <= 24.9:
    print('Peso Ideal.')
elif 25 <= imc <= 29.9:
    print('Sobre peso')
elif 30 <= imc <= 39.9:
    print('Obesidade')
else:
    print('obesidade morbita')
            