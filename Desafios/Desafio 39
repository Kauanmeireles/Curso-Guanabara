from datetime import datetime
ano = int(input('Digite o ano de seu nascimento: '))
ano_atual = datetime.now().year
idade = ano_atual - ano

if idade < 18:
    saldo = 18 - idade
    alistamento = ano_atual + saldo
    print(f'Voce ainda vai se alistar, faltam {saldo} anos.')
    print(f'Seu alistamento sera em {alistamento}')
elif idade == 18:
    print('Voce esta na hora de se alistar.')
else:
    saldo = idade -18
    alistamento = ano_atual - saldo
    print(f'Ja Devia ter se alistado ha {idade - 18} anos atras.')
    print(f'Seu alistamento foi em {alistamento}')