nome = input('Digite seu nome: ')

print('\nAnalisando.....\n')
print(f'Seu nome em Maiusculo é {nome.upper()}!')
print(f'Seu nome em Minusculo é {nome.lower()}')
print(f'Seu nome contem {len(nome.replace(' ',''))}!')

nome_separado = nome.split ()

print(f'Seu primeiro nome é {nome_separado[0]} e contém {len(nome_separado[0])}!')
print('\n')
