total = 0
num = int(input("Digite o numero: "))

for i in range(1, num + 1):
    if num % i == 0:
        total += 1
        print("\033[32m", end=" ")
    else:
        print("\033[31m", end=" ")

    print(f"{i}", end=" ")

print(f"\n\033[mO numero {num} foi divisivel por {total} vezes")
if total == 2:
    print("Seu número é primo")
else:
    print("Seu numero não é primo")
