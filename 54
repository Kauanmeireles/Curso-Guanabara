maior = 0
menor = 0

import datetime


ano_atual = datetime.datetime.now().year

for i in range(1, 7):
    ano = int(input(f"Digite o ano de nascimento da {i}ª pessoa: "))
    idade = ano_atual - ano

    if idade >= 18:
        maior += 1

    else:
        menor += 1


print(f"Maiores de idades {maior} e Menores de idade {menor}")
